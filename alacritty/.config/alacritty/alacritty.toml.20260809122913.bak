
[font]
size = 14.0

[font.normal]
family = "VictorMono Nerd Font"
style = "SemiBold"

[[mouse.bindings]]
action = "PasteSelection"
mouse = "Middle"

[[keyboard.bindings]]
key = "V"
mods = "Control"
action = "Paste"

[[keyboard.bindings]]
key = "C"
mods = "Control"
action = "Copy"

[[keyboard.bindings]]
key = "K"
mods = "Control"
chars = "\u0003"

[[keyboard.bindings]]
key = "Return"
mods = "Shift"
chars = "\u001B\r"
