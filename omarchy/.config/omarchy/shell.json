              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            }
          ],
          "id": "omarchy.elsewhen"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "io.github.shyamenk.cmf-buds"
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "io.github.mattwolfgang.simple-cliamp-bar-controls"
        },
        {
          "id": "omarchy.system-update"
